---
import Project from './Project.astro'

interface Image {
  path: string
  alt: string
  width: number
  height: number
}

interface ProjectData {
  name: string
  description: string
  front?: string
  back?: string
  images: Image[]
  date: string
}

interface Props {
  projects: ProjectData[]
}

const { projects } = Astro.props
---

<section class="section content projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="headline" data-aos="zoom-out-up" data-aos-delay="300">Projects</h2>
  <div class="list">
    {projects.map((project, index) => <Project project={project} reverse={index % 2 === 1} />)}
  </div>
</section>

<style lang="scss">
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  .list { display: flex; flex-direction: column; width: 100%; margin-top: 5vw; }
  .projects { opacity: 0; animation: fade 0.5s 2s forwards; }
</style>
